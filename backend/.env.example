# Runtime
NODE_ENV=development
PORT=3000

# Database
PRISMA_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173

# Security
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
OTP_HASH_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# SMTP
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=587
SMTP_USER=YOUR_SMTP_LOGIN
SMTP_PASS=YOUR_SMTP_PASSWORD_OR_KEY
MAIL_FROM_NAME=QMDATN2026
MAIL_FROM_ADDRESS=YOUR_VERIFIED_SENDER_EMAIL

# Admin seed - only needed when running seed-admin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
ADMIN_FULL_NAME=System Admin
